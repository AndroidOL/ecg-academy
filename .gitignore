storage/sessions/*
storage/logs/*
storage/cache/*
!storage/sessions/.gitkeep
!storage/logs/.gitkeep
!storage/cache/.gitkeep
app/config.local.php
*.swp
.DS_Store
tests/artifacts/*
!tests/artifacts/.gitkeep
.ssh/
docs/*.local.md
node_modules/

# runtime encryption master key
storage/master.key

# local test-data backups
storage/backups/

# imported/protected waveform data must be reviewed before commit
# keep the directory README, ignore raw JSON by default
data/imports/*.json
!data/imports/README.md
